{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/audio-edit.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/.pnpm/@ffmpeg-installer+linux-x64@*/node_modules/@ffmpeg-installer/linux-x64/ffmpeg"
    },
    "api/video-to-audio.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/.pnpm/@ffmpeg-installer+linux-x64@*/node_modules/@ffmpeg-installer/linux-x64/ffmpeg"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "mahbubsardarsabuj.com"
        }
      ],
      "destination": "https://www.mahbubsardarsabuj.com/$1",
      "permanent": true
    },
    {
      "source": "/:path((?!ads.txt|robots.txt|sitemap.xml|manifest.json).*)",
      "has": [
        {
          "type": "host",
          "value": "mahbub-sardar-sabuj-live.vercel.app"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "_bypass"
        }
      ],
      "destination": "https://www.mahbubsardarsabuj.com/:path",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/(.*\\.(?:js|css|png|jpg|jpeg|gif|svg|webp|PNG|JPG|JPEG|GIF|mp4|webm|woff|woff2|ttf|otf|eot|ico|xml|txt|pdf|zip|rar|json|webmanifest|map))$",
      "dest": "/$1"
    },
    {
      "src": "/([^.]*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(Googlebot|Googlebot-News|Googlebot-Image|Googlebot-Video|AdsBot-Google|Google-InspectionTool|bingbot|Baiduspider|YandexBot|DuckDuckBot|facebookexternalhit|facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|Applebot|ia_archiver).*"
        }
      ],
      "dest": "/api/ssr-og?path=/$1"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(Googlebot|Googlebot-News|Googlebot-Image|Googlebot-Video|AdsBot-Google|Google-InspectionTool|bingbot|Baiduspider|YandexBot|DuckDuckBot|facebookexternalhit|facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|Applebot|ia_archiver).*"
        }
      ],
      "dest": "/api/ssr-og?path=/"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:png|jpg|jpeg|gif|svg|webp|ico|PNG|JPG|JPEG|GIF))$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "nodeVersion": "20.x"
}
