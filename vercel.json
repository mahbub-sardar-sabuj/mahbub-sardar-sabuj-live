{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/trpc-bundled.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/upload.js": {
      "memory": 512
    },
    "api/profile.js": {
      "memory": 256
    },
    "api/audio-edit.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/.pnpm/@ffmpeg-installer+linux-x64@*/node_modules/@ffmpeg-installer/linux-x64/ffmpeg"
    },
    "api/video-to-audio.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/.pnpm/@ffmpeg-installer+linux-x64@*/node_modules/@ffmpeg-installer/linux-x64/ffmpeg"
    }
  },
  "redirects": [
    {
      "source": "/ebooks",
      "destination": "/ebooks/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "mahbubsardarsabuj.com"
        }
      ],
      "destination": "https://www.mahbubsardarsabuj.com/$1",
      "permanent": true
    },
    {
      "source": "/:path((?!ads.txt|robots.txt|sitemap.xml|sitemap-index.xml|news-sitemap.xml|manifest.json|llms.txt|humans.txt).*)",
      "has": [
        {
          "type": "host",
          "value": "mahbub-sardar-sabuj-live.vercel.app"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "_bypass"
        }
      ],
      "destination": "https://www.mahbubsardarsabuj.com/:path",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/api/trpc/(.*)",
      "dest": "/api/trpc-bundled?trpc=$1"
    },
    {
      "src": "/api/telegram/webhook",
      "dest": "/api/trpc-bundled?_telegram_webhook=1"
    },
    {
      "src": "/api/contact",
      "dest": "/api/trpc-bundled"
    },
    {
      "src": "/api/chatbot-notify",
      "dest": "/api/trpc-bundled"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/mahbubsardarsabuj2026bd.txt",
      "dest": "/mahbubsardarsabuj2026bd.txt"
    },
    {
      "src": "/ads.txt",
      "dest": "/ads.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/sitemap-index.xml",
      "dest": "/sitemap-index.xml"
    },
    {
      "src": "/news-sitemap.xml",
      "dest": "/news-sitemap.xml"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/(.*\\.(?:js|css|png|jpg|jpeg|gif|svg|webp|PNG|JPG|JPEG|GIF|mp4|webm|woff|woff2|ttf|otf|eot|ico|xml|txt|pdf|zip|rar|json|webmanifest|map))$",
      "dest": "/$1"
    },
    {
      "src": "/(writings|ebooks)/?",
      "dest": "/index.html"
    },
    {
      "src": "/([^.]*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(Googlebot|Googlebot-News|Googlebot-Image|Googlebot-Video|AdsBot-Google|Google-InspectionTool|bingbot|Baiduspider|YandexBot|DuckDuckBot|facebookexternalhit|facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|Applebot|ia_archiver|GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-SearchBot|Claude-User|anthropic-ai|PerplexityBot|Perplexity-User|YouBot|CCBot|Bytespider|Meta-ExternalAgent|Meta-ExternalFetcher|Amazonbot|Diffbot|cohere-ai|MistralAI-User|AI2Bot|omgili|omgilibot).*"
        }
      ],
      "dest": "/api/ssr-og?path=/$1"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(Googlebot|Googlebot-News|Googlebot-Image|Googlebot-Video|AdsBot-Google|Google-InspectionTool|bingbot|Baiduspider|YandexBot|DuckDuckBot|facebookexternalhit|facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|Applebot|ia_archiver|GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-SearchBot|Claude-User|anthropic-ai|PerplexityBot|Perplexity-User|YouBot|CCBot|Bytespider|Meta-ExternalAgent|Meta-ExternalFetcher|Amazonbot|Diffbot|cohere-ai|MistralAI-User|AI2Bot|omgili|omgilibot).*"
        }
      ],
      "dest": "/api/ssr-og?path=/"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://googleads.g.doubleclick.net https://tpc.googlesyndication.com"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:js|mjs))$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.css)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:woff|woff2|ttf|otf|eot))$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:png|jpg|jpeg|gif|svg|webp|ico|PNG|JPG|JPEG|GIF))$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
