{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/trpc.ts": {
      "includeFiles": "{shared/**,server/**,drizzle/**,node_modules/@trpc/**,node_modules/drizzle-orm/**,node_modules/mysql2/**,node_modules/jose/**,node_modules/superjson/**,node_modules/zod/**,node_modules/axios/**,node_modules/nanoid/**,node_modules/cookie/**,node_modules/asynckit/**,node_modules/combined-stream/**,node_modules/debug/**,node_modules/ms/**,node_modules/follow-redirects/**,node_modules/form-data/**,node_modules/mime-types/**,node_modules/mime-db/**,node_modules/copy-anything/**,node_modules/is-what/**,node_modules/lru-cache/**,node_modules/lru.min/**,node_modules/named-placeholders/**,node_modules/seq-queue/**,node_modules/sqlstring/**,node_modules/aws-ssl-profiles/**,node_modules/denque/**,node_modules/long/**,node_modules/generate-function/**,node_modules/is-property/**,node_modules/safer-buffer/**,node_modules/delayed-stream/**,node_modules/proxy-from-env/**,node_modules/call-bind-apply-helpers/**,node_modules/dunder-proto/**,node_modules/es-define-property/**,node_modules/es-errors/**,node_modules/es-object-atoms/**,node_modules/es-set-tostringtag/**,node_modules/function-bind/**,node_modules/get-intrinsic/**,node_modules/get-proto/**,node_modules/gopd/**,node_modules/has-symbols/**,node_modules/has-tostringtag/**,node_modules/hasown/**,node_modules/math-intrinsics/**}"
    },
    "api/audio-edit.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/.pnpm/@ffmpeg-installer+linux-x64@*/node_modules/@ffmpeg-installer/linux-x64/ffmpeg"
    },
    "api/video-to-audio.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/.pnpm/@ffmpeg-installer+linux-x64@*/node_modules/@ffmpeg-installer/linux-x64/ffmpeg"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "mahbubsardarsabuj.com"
        }
      ],
      "destination": "https://www.mahbubsardarsabuj.com/$1",
      "permanent": true
    },
    {
      "source": "/:path((?!ads.txt|robots.txt|sitemap.xml|news-sitemap.xml|manifest.json).*)",
      "has": [
        {
          "type": "host",
          "value": "mahbub-sardar-sabuj-live.vercel.app"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "_bypass"
        }
      ],
      "destination": "https://www.mahbubsardarsabuj.com/:path",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/api/trpc/(.*)",
      "dest": "/api/trpc?trpc=$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/news-sitemap.xml",
      "dest": "/news-sitemap.xml"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/(.*\\.(?:js|css|png|jpg|jpeg|gif|svg|webp|PNG|JPG|JPEG|GIF|mp4|webm|woff|woff2|ttf|otf|eot|ico|xml|txt|pdf|zip|rar|json|webmanifest|map))$",
      "dest": "/$1"
    },
    {
      "src": "/([^.]*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(Googlebot|Googlebot-News|Googlebot-Image|Googlebot-Video|AdsBot-Google|Google-InspectionTool|bingbot|Baiduspider|YandexBot|DuckDuckBot|facebookexternalhit|facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|Applebot|ia_archiver).*"
        }
      ],
      "dest": "/api/ssr-og?path=/$1"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(Googlebot|Googlebot-News|Googlebot-Image|Googlebot-Video|AdsBot-Google|Google-InspectionTool|bingbot|Baiduspider|YandexBot|DuckDuckBot|facebookexternalhit|facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|Applebot|ia_archiver).*"
        }
      ],
      "dest": "/api/ssr-og?path=/"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:png|jpg|jpeg|gif|svg|webp|ico|PNG|JPG|JPEG|GIF))$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
